#!/usr/bin/env sh
set -eu

# Resolve installation directory cleanly across symlinks
SCRIPT_PATH="$0"
if command -v readlink >/dev/null 2>&1; then
    RESOLVED="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || printf '%s' "$SCRIPT_PATH")"
else
    RESOLVED="$SCRIPT_PATH"
fi
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$RESOLVED")" && pwd)"
APP_HOME="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

# Locate JAR in packaged layout (share/drivepad-companion/lib or ../lib)
JAR_PATH=""
for candidate in \
    "$APP_HOME/lib"/drivepad-companion-*-all.jar \
    "$APP_HOME/share/drivepad-companion/lib"/drivepad-companion-*-all.jar; do
    if [ -f "$candidate" ]; then
        JAR_PATH="$candidate"
        break
    fi
done

if [ -z "$JAR_PATH" ]; then
    echo "Error: Could not find drivepad-companion-*-all.jar under $APP_HOME" >&2
    exit 1
fi

# Prefer optional bundled runtime if present, else JAVA_HOME or system java
if [ -x "$APP_HOME/runtime/bin/java" ]; then
    JAVA_BIN="$APP_HOME/runtime/bin/java"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_BIN="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
    JAVA_BIN="$(command -v java)"
else
    echo "Error: Java 21+ runtime not found." >&2
    echo "Install OpenJDK 21+ (Arch Linux: sudo pacman -S jre21-openjdk | Ubuntu/Debian: sudo apt install openjdk-21-jre)" >&2
    exit 1
fi

JAVA_VER_LINE="$("$JAVA_BIN" -version 2>&1 | head -n 1 || true)"
JAVA_MAJOR="$(printf '%s' "$JAVA_VER_LINE" | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p')"
if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -lt 21 ]; then
    echo "Error: DrivePad Companion requires Java 21 or newer (found Java $JAVA_MAJOR via $JAVA_BIN)." >&2
    exit 1
fi

exec "$JAVA_BIN" -jar "$JAR_PATH" "$@"
